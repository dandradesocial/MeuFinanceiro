<Page
    x:Class="MeuFinanceiro.UI.Pages.ResumoMensalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MeuFinanceiro.UI.Pages"
    xmlns:converters="using:MeuFinanceiro.UI.Converters">

    <Page.Resources>
        <converters:CurrencyConverter x:Key="CurrencyConverter"/>
    </Page.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0"
                   Text="Resumo Mensal"
                   Style="{ThemeResource TitleTextBlockStyle}"
                   Margin="0,0,0,12"/>

        <!-- Filtros -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
            <CalendarDatePicker x:Name="dataInicioPicker" PlaceholderText="Data início"/>
            <CalendarDatePicker x:Name="dataFimPicker" PlaceholderText="Data fim"/>
            <Button Content="Filtrar" Command="{x:Bind ViewModel.LoadCommand}"/>
        </StackPanel>

        <!-- Lista de subtipos com categorias e totais -->
        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Resumos, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,16">
                            <!-- Nome do subtipo (tabela) -->
                            <TextBlock Text="{Binding SubtipoNome}"
                                       FontWeight="SemiBold"
                                       FontSize="16"
                                       Margin="0,0,0,8"/>

                            <!-- Lista de categorias do subtipo -->
                            <ItemsControl ItemsSource="{Binding CategoriasTotais}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="12" Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="150"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding CategoriaNome}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Total, Converter={StaticResource CurrencyConverter}}"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>