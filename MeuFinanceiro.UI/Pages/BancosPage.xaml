<Page
    x:Class="MeuFinanceiro.UI.Pages.BancosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MeuFinanceiro.UI.Pages"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    x:Name="RootPage">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho e botão Adicionar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
            <TextBlock Text="Gestão de Bancos" Style="{ThemeResource TitleTextBlockStyle}"/>
            <Button Content="Adicionar" Command="{Binding ViewModel.AddCommand, ElementName=RootPage}"/>
        </StackPanel>

        <!-- Tabela de bancos com menu de contexto -->
        <controls:DataGrid
            Grid.Row="1"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            ItemsSource="{Binding Bancos}"
            SelectedItem="{Binding BancoSelecionado, Mode=TwoWay}"
            RightTapped="DataGrid_RightTapped">

            <controls:DataGrid.Columns>
                <!-- Coluna com indicador de cor + nome -->
                <controls:DataGridTemplateColumn Header="Banco">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Rectangle Width="20" Height="20" RadiusX="4" RadiusY="4" Fill="{Binding CorHex}" />
                                <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>
            </controls:DataGrid.Columns>
        </controls:DataGrid>
    </Grid>
</Page>