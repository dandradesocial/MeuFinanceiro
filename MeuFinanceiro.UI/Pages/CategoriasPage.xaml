<Page
    x:Class="MeuFinanceiro.UI.Pages.CategoriasPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MeuFinanceiro.UI.Pages"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    x:Name="RootPage">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
            <TextBlock Text="Gestão de Categorias" Style="{ThemeResource TitleTextBlockStyle}"/>
            <Button Content="Adicionar" Command="{Binding ViewModel.AddCommand, ElementName=RootPage}"/>
            <Button Content="Novo Subtipo" Command="{Binding ViewModel.NovoSubtipoCommand, ElementName=RootPage}"/>
        </StackPanel>

        <!-- DataGrid de categorias -->
        <controls:DataGrid
            Grid.Row="1"
            x:Name="CategoriasGrid"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            IsRightTapEnabled="False"
            ItemsSource="{Binding Categorias}"
            SelectedItem="{Binding CategoriaSelecionada, Mode=TwoWay}"
            RightTapped="DataGrid_RightTapped">
            <controls:DataGrid.Columns>
                <controls:DataGridTextColumn Header="Nome" Binding="{Binding Nome}" />
                <controls:DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" />
                <controls:DataGridTextColumn Header="Subtipo" Binding="{Binding SubTipo.Nome}" />
            </controls:DataGrid.Columns>
        </controls:DataGrid>

        <!-- Botão flutuante no canto inferior direito -->
        <Button
            Grid.Row="1"
            Content="Gerenciar Subtipos"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,24,24"
            Click="OnGerenciarSubtiposClick"/>
    </Grid>
</Page>