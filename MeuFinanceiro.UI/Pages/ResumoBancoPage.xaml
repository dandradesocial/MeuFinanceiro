<Page
    x:Class="MeuFinanceiro.UI.Pages.ResumoBancoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MeuFinanceiro.UI.Pages"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:converters="using:MeuFinanceiro.UI.Converters">

    <Page.Resources>
        <converters:DateToStringConverter x:Key="DateConverter"/>
        <converters:CurrencyConverter x:Key="CurrencyConverter"/>
    </Page.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título da página -->
        <TextBlock Grid.Row="0"
                   Text="Resumo por Banco"
                   Style="{ThemeResource TitleTextBlockStyle}"
                   Margin="0,0,0,12"/>

        <!-- Filtros de período -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
            <CalendarDatePicker x:Name="dataInicioPicker" PlaceholderText="Data início"/>
            <CalendarDatePicker x:Name="dataFimPicker" PlaceholderText="Data fim"/>
            <Button Content="Filtrar" Command="{x:Bind ViewModel.LoadCommand}"/>
        </StackPanel>

        <!-- Bancos lado a lado com rolagem horizontal e vertical -->
        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      VerticalAlignment="Top">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Resumos, Mode=OneWay}"
                          VerticalAlignment="Top">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Top"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="350" VerticalAlignment="Top" Margin="0,0,0,8">
                            <Expander HorizontalContentAlignment="Stretch"
                                      VerticalAlignment="Top"
                                      IsExpanded="False">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Rectangle Width="20" Height="20"
                                                   RadiusX="4" RadiusY="4"
                                                   Fill="{Binding Banco.CorHex}" />
                                        <TextBlock Text="{Binding Banco.Nome}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Expander.Header>
                                <Expander.Content>
                                    <ScrollViewer MaxHeight="300"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Spacing="8" Margin="0,8,0,0">
                                            <!-- Seção Pix/Débito -->
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Pix/Débito" FontWeight="SemiBold"/>
                                                <controls:DataGrid
                                                    AutoGenerateColumns="False"
                                                    IsReadOnly="True"
                                                    ItemsSource="{Binding PixDebitoTransacoes}">
                                                    <controls:DataGrid.Columns>
                                                        <controls:DataGridTextColumn Header="Data" Binding="{Binding Data, Converter={StaticResource DateConverter}}" />
                                                        <controls:DataGridTextColumn Header="Valor" Binding="{Binding Valor, Converter={StaticResource CurrencyConverter}}" />
                                                        <controls:DataGridTextColumn Header="Categoria" Binding="{Binding Categoria.Nome}" />
                                                    </controls:DataGrid.Columns>
                                                </controls:DataGrid>
                                            </StackPanel>

                                            <!-- Seção Crédito -->
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Crédito" FontWeight="SemiBold"/>
                                                <controls:DataGrid
                                                    AutoGenerateColumns="False"
                                                    IsReadOnly="True"
                                                    ItemsSource="{Binding CreditoTransacoes}">
                                                    <controls:DataGrid.Columns>
                                                        <controls:DataGridTextColumn Header="Data" Binding="{Binding Data, Converter={StaticResource DateConverter}}" />
                                                        <controls:DataGridTextColumn Header="Valor" Binding="{Binding Valor, Converter={StaticResource CurrencyConverter}}" />
                                                        <controls:DataGridTextColumn Header="Categoria" Binding="{Binding Categoria.Nome}" />
                                                    </controls:DataGrid.Columns>
                                                </controls:DataGrid>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Expander.Content>
                            </Expander>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>